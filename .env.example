# Frontend API origin
# - Web on Railway (same app serving frontend+backend): leave empty to use same origin
# - Mobile builds: set to your Railway backend origin
#   Example: https://your-app-name.up.railway.app
VITE_API_URL=
# Optional platform overrides (recommended for native debug)
# Android emulator: http://10.0.2.2:3001
# Android real device: http://YOUR_COMPUTER_LAN_IP:3001
VITE_ANDROID_API_URL=
# iOS simulator: http://localhost:3001
# iOS real device: http://YOUR_COMPUTER_LAN_IP:3001
VITE_IOS_API_URL=

# Backend runtime secrets (Railway Variables)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Admin (required for native push while app is background/closed)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n in env value if set via Railway Variables
FIREBASE_PRIVATE_KEY=

# Native app FCM token registration toggle
# Set to true only after adding google-services.json / GoogleService-Info.plist
VITE_ENABLE_NATIVE_PUSH=false

# Optional backend port override (Railway injects PORT automatically)
PORT=3001
