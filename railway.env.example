# App runtime
PORT=3001
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Turso
TURSO_DATABASE_URL=libsql://YOUR_DB_NAME.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Web Push (browser)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:you@example.com

# Firebase Admin (native mobile push)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# IMPORTANT: keep \n escaped exactly like below in Railway Variables
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINE_1\nYOUR_KEY_LINE_2\nYOUR_KEY_LINE_3\n-----END PRIVATE KEY-----\n
# Frontend build-time API base (Railway single-host setup)
VITE_API_URL=https://42bus.up.railway.app/
VITE_ANDROID_API_URL=https://42bus.up.railway.app/
VITE_IOS_API_URL=https://42bus.up.railway.app/
VITE_ENABLE_NATIVE_PUSH=true
